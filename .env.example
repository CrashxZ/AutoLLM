CARLA_HOST=127.0.0.1
CARLA_PORT=2000
# Set to your CARLA 0.9.15 installation when using its bundled Python API.
CARLA_DIR=/path/to/carla
MIND_CAV_V2_ENABLED=1
MIND_CAV_V2_PROPOSER=ranked
MIND_CAV_V2_LIVENESS_PREPARATION=1
MIND_CAV_V2_GLOBAL_CONFLICT_RECOVERY=1
MIND_CAV_V2_EXECUTION_AWARE_VALIDATOR=0
# Launch commands from the repository root.
MIND_CAV_RANKER_VARIANT=deterministic
MIND_CAV_RANKER_MODEL=models/candidate_ranker.npz
MARL_MODEL_PATH=models/mappo_actor.npz
# No API key is required for the deterministic/learned reference coordinators.
OPENAI_API_KEY=
MEC_OPENAI_MODEL=gpt-4o-mini
